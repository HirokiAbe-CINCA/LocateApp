<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.cinca.LocateApp.tunneld</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/LocateTunneldDaemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>LocateTunneldDaemon</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Library/Logs/jp.cinca.LocateApp.tunneld.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/jp.cinca.LocateApp.tunneld.err.log</string>
</dict>
</plist>
